# Copie este archivo como api/.env y complete los valores reales.
# Nunca suba api/.env al repositorio (ya está cubierto por el .gitignore raíz).
#
# DATABASE_URL es la cadena de conexión que usa Prisma contra MySQL.
# Formato: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE_DE_DATOS

DATABASE_URL="mysql://root:SU_CLAVE_AQUI@127.0.0.1:3306/vivero_paraiso"

# Puerto donde escucha la API Node.js
PORT=4000

# Origen permitido para CORS (la app Flask en desarrollo)
CORS_ORIGIN=http://127.0.0.1:5000
